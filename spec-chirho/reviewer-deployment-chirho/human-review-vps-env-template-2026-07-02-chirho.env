# For God so loved the world, that he gave his only begotten Son,
# that whosoever believeth in him should not perish, but have everlasting life. — John 3:16 (KJV)

# Copy to /etc/hottp-review-chirho.env on the review VPS and set permissions so
# only root/the review service can read it. Do not commit the filled file.

HOTTP_REVIEW_USER_CHIRHO=replace-with-caddy-basic-auth-user-chirho
HOTTP_REVIEW_PASSWORD_HASH_CHIRHO=replace-with-caddy-hash-password-output-chirho
HOTTP_REVIEW_FALLBACK_REVIEWER_CHIRHO=server-fallback-reviewer-chirho
HOTTP_TRUSTED_REVIEWER_HEADER_CHIRHO=x-webauth-user
